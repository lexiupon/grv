{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Salesforce adapter binding schema v1",
  "$comment": "Uses the same common envelope/validation points as DuckDB and future registered adapters. This adapter advertises push only and no managed/external build support.",
  "$defs": {
    "connection": {
      "type": "object",
      "properties": {
        "org": {
          "type": "string",
          "minLength": 1
        },
        "api_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "org"
      ]
    },
    "options": {
      "type": "object",
      "properties": {
        "transport": {
          "enum": [
            "auto",
            "rest",
            "bulk"
          ]
        },
        "all_rows": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "extract_source": {
      "type": "object",
      "properties": {
        "object": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "filter": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "object"
      ]
    },
    "column_source": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "push_result": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "connection_details": {
      "type": "object",
      "properties": {
        "org_id": {
          "type": "string",
          "pattern": "^00D[A-Za-z0-9]{12}([A-Za-z0-9]{3})?$"
        },
        "api_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "org_id",
        "api_version"
      ],
      "$comment": "Resolved org identity after authentication; the alias and credentials are never reported."
    },
    "source_identity": {
      "type": "object",
      "properties": {
        "org_id": {
          "type": "string",
          "pattern": "^00D[A-Za-z0-9]{12}([A-Za-z0-9]{3})?$"
        },
        "object": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "query_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "org_id",
        "object",
        "query_sha256"
      ],
      "$comment": "query_sha256 hashes the exact generated SOQL text."
    },
    "source_job": {
      "type": "object",
      "properties": {
        "transport": {
          "enum": [
            "rest",
            "bulk"
          ]
        },
        "api_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        },
        "job_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "transport",
        "api_version",
        "job_ids"
      ],
      "$comment": "Bulk job IDs or REST query locators recorded durably before fetching; empty only before the first job is created."
    }
  }
}
