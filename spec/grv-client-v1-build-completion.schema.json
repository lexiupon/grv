{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRV Client v1 build completion record",
  "$comment": "The driver attests completion. Validate unique output table names, exact session binding/mappings, and complete selected-output coverage through grv-client-v1.md.",
  "type": "object",
  "properties": {
    "result_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "workspace_id": { "type": "string", "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$" },
    "declaration_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kind": { "enum": ["engine", "direct", "omission-only"] },
    "invocation_id": { "type": "string", "minLength": 1 },
    "status": { "const": "succeeded" },
    "writers_stopped": { "const": true },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "completed_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
          "engine_table": { "type": "string", "pattern": "^[a-z0-9_][a-z0-9_-]*\\.[a-z0-9_][a-z0-9_-]*$" }
        },
        "additionalProperties": false,
        "required": ["table", "engine_table"]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "required": [
    "result_version",
    "run_id",
    "workspace_id",
    "declaration_sha256",
    "kind",
    "invocation_id",
    "status",
    "writers_stopped",
    "completed_at",
    "completed_outputs"
  ],
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "omission-only" } } },
      "then": { "properties": { "completed_outputs": { "maxItems": 0 } } }
    }
  ]
}
