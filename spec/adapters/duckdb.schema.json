{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DuckDB adapter binding schema v1",
  "$comment": "Registry validation points, not an alternative declaration envelope. Apply these definitions to corresponding common fields; inspect build.execution to choose the source definition. Semantic rules are in grv-client-v1.md. Relative $ref values into sibling GRV schemas are resolved and bundled into one self-contained resource at installation/handshake, as the adapter process protocol \u00a73.2 requires.",
  "$defs": {
    "connection": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": ["database"]
    },
    "options": {
      "type": "object",
      "properties": {
        "materialization": {
          "enum": ["local", "s3-view"]
        },
        "refresh": {
          "enum": ["auto", "full"]
        }
      },
      "additionalProperties": false,
      "$comment": "Pull options. Use push_options for extraction/build; binding validation selects by kind."
    },
    "extract_source": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*\\.[a-z0-9_][a-z0-9_-]*$"
        },
        "filter": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": ["table"]
    },
    "managed_build_source": {
      "type": "object",
      "properties": {
        "sql": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": ["sql"]
    },
    "external_build_source": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        }
      },
      "additionalProperties": false,
      "required": ["table"]
    },
    "column_source": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "pull_target": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        }
      },
      "additionalProperties": false,
      "required": ["schema"]
    },
    "pull_table_target": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        }
      },
      "additionalProperties": false
    },
    "select": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": ["sql"]
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": ["file"]
        }
      ]
    },
    "build_input": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_-]*\\.[a-z0-9_][a-z0-9_-]*$"
    },
    "pull_result": {
      "type": "object",
      "properties": {
        "target_schema": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        },
        "write_mode": {
          "enum": ["replace", "append"]
        },
        "transform_mode": {
          "enum": ["identity", "sql"]
        },
        "scope_mode": {
          "enum": ["complete", "selected"]
        },
        "materialization_mode": {
          "enum": ["local", "s3-view"]
        },
        "source_partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "partition": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                  "not": {
                    "enum": ["version", "revision"]
                  }
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                }
              }
            },
            "additionalProperties": false,
            "required": ["table", "partition"]
          }
        }
      },
      "additionalProperties": false,
      "required": ["target_schema", "write_mode", "transform_mode", "scope_mode", "materialization_mode", "source_partitions"]
    },
    "push_result": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "inspection_result": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding": {
          "enum": ["bound", "uninitialized"]
        },
        "materializations": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/engine_materialization"
              },
              {
                "$ref": "../grv-client-v1-command-output.schema.json#/$defs/materialization"
              }
            ]
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/engine_session"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "../grv-client-v1-command-output.schema.json#/$defs/application_import"
          }
        }
      },
      "additionalProperties": false,
      "required": ["path", "workspace_id", "binding", "materializations", "sessions", "imports"]
    },
    "session_details": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "minLength": 1
        },
        "input_mappings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "alias": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "engine_table": {
                "type": "string",
                "pattern": "^_grv_session_[0-9a-f]{32}\\.input_[0-9]+$"
              }
            },
            "additionalProperties": false,
            "required": ["alias", "engine_table"]
          }
        },
        "self_mappings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "engine_table": {
                "type": "string",
                "pattern": "^_grv_session_[0-9a-f]{32}\\.self_[0-9]+$"
              }
            },
            "additionalProperties": false,
            "required": ["table", "engine_table"]
          }
        }
      },
      "additionalProperties": false,
      "required": ["database", "input_mappings", "self_mappings"]
    },
    "push_options": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "connection_details": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding": {
          "enum": ["bound", "uninitialized", "not_applicable"]
        }
      },
      "additionalProperties": false,
      "required": ["database", "workspace_id", "binding"],
      "$comment": "Canonical absolute database path and observed root/workspace binding; extraction from unmanaged tables reports not_applicable."
    },
    "source_identity": {
      "type": "object",
      "properties": {
        "relation": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*\\.[a-z0-9_][a-z0-9_-]*$"
        },
        "database": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": ["relation", "database"],
      "$comment": "One extracted relation, read inside the stream's single snapshot transaction."
    },
    "source_job": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "required": [],
      "$comment": "DuckDB extraction has no remote job; the snapshot transaction is local to the adapter process."
    },
    "pull_plan": {
      "type": "object",
      "properties": {
        "target_schema": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        },
        "role": {
          "enum": ["identity", "application"]
        },
        "refresh": {
          "enum": ["changed", "full"]
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "target_table": {
                "type": "string",
                "pattern": "^[a-z0-9_][a-z0-9_-]*$"
              }
            },
            "additionalProperties": false,
            "required": ["table", "target_table"]
          },
          "minItems": 1
        },
        "prior_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "prior_generation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "obsolete_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_][a-z0-9_-]*$"
          }
        }
      },
      "additionalProperties": false,
      "required": ["target_schema", "role", "refresh", "mappings", "prior_revision", "prior_generation_id", "obsolete_targets"],
      "$comment": "Transactional adapter: PullResolution.recovery is always null, so this point validates only PullPlan.adapter_details. prior_* describe the committed checkpoint the diff was planned against; obsolete_targets are owned targets cleared by a mapping change."
    },
    "engine_materialization": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "target_schema": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        },
        "revision_mode": {
          "enum": ["latest", "fixed"]
        },
        "materialization_mode": {
          "enum": ["local", "s3-view"]
        },
        "committed_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$"
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "grv_table": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "target_table": {
                "type": "string",
                "pattern": "^[a-z0-9_][a-z0-9_-]*\\.[a-z0-9_][a-z0-9_-]*$"
              }
            },
            "additionalProperties": false,
            "required": ["grv_table", "target_table"]
          }
        },
        "adapter": {
          "const": "duckdb"
        },
        "write_mode": {
          "const": "replace"
        },
        "transform_mode": {
          "const": "identity"
        }
      },
      "additionalProperties": false,
      "required": [
        "dataset",
        "target_schema",
        "revision_mode",
        "materialization_mode",
        "committed_revision",
        "generation_id",
        "mappings",
        "adapter",
        "write_mode",
        "transform_mode"
      ]
    },
    "engine_session": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$"
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$"
        },
        "base_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "input_revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dataset": {
                "type": "string"
              },
              "revision": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            },
            "required": ["dataset", "revision"],
            "additionalProperties": false
          }
        },
        "state": {
          "enum": ["prepared", "executing", "completed", "aborted"]
        },
        "completion_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["published", "no-op", "aborted"]
                },
                "revision": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operation_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false,
              "required": ["kind", "revision", "operation_id"]
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "$ref": "../grv-client-v1-command-output.schema.json#/$defs/run_observation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "dataset",
        "run_id",
        "attempt_id",
        "session_id",
        "workspace_id",
        "base_revision",
        "input_revisions",
        "state",
        "completion_sha256",
        "outcome"
      ]
    }
  }
}
